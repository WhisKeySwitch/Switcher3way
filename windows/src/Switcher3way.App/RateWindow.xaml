<Window
    x:Class="Switcher3way.App.RateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Switcher3way">

    <Grid Padding="22,20" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- The card sits in the star row, so it must be given room: when the window is too short for
             the Auto rows the star row collapses to nothing and the card renders as an empty strip
             with its text invisible rather than clipped. The ScrollViewer is what makes a long
             translation (German and Greek run half again the length of English) scroll instead. -->
        <Border Grid.Row="2" Padding="16,14" CornerRadius="6" VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer MaxHeight="150">
                <TextBlock x:Name="BodyText" FontSize="13" TextWrapping="Wrap" LineHeight="19" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button x:Name="RateButton" Style="{StaticResource AccentButtonStyle}" Click="Rate_Click" />
            <Button x:Name="LaterButton" Grid.Column="1" Click="Later_Click" />
            <HyperlinkButton x:Name="NeverButton" Grid.Column="3" Click="Never_Click" />
        </Grid>
    </Grid>
</Window>
