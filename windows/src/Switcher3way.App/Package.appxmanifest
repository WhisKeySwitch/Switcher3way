<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX manifest for the Microsoft Store build.

  Identity below is the real Partner Center identity for this app (Store ID 9MXFXL7GG3C5,
  PFN IronMade.Switcher3Way_zeh9vvkybnryc) — it must match Partner Center exactly, including the
  capital W in "Switcher3Way", or the upload is rejected. The Store re-signs the package, which is
  what removes the SmartScreen "unknown publisher" warning.

  runFullTrust is a RESTRICTED capability: Switcher3way needs a system-wide keyboard hook to see
  what is typed and SendInput to rewrite it, neither of which works in the app-container sandbox.
  Store submission therefore requires a written justification and gets a manual review.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 com desktop rescap">

  <Identity
    Name="IronMade.Switcher3Way"
    Publisher="CN=AF9BB38F-30B9-45AC-B73D-521C0053C310"
    Version="0.4.0.0" />

  <Properties>
    <DisplayName>Switcher3way</DisplayName>
    <PublisherDisplayName>IronMade</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="uk" />
    <Resource Language="ru" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Switcher3way.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Switcher3way"
        Description="Fixes the keyboard layout when you type in the wrong one — English, Ukrainian and Russian."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Images\Wide310x150Logo.png"
          Square71x71Logo="Images\SmallTile.png"
          Square310x310Logo="Images\LargeTile.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- "Start with Windows": the packaged equivalent of the Startup-folder shortcut.
             TaskId must match StartupShortcut.TaskId. Off by default; the app enables it. -->
        <uap5:Extension Category="windows.startupTask" Executable="Switcher3way.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="Switcher3wayStartup" Enabled="false" DisplayName="Switcher3way" />
        </uap5:Extension>

        <!-- Notification activator. NOT optional, and not only about clicking a notification:
             AppNotificationManager.Register() takes a different path when the process has package
             identity — it looks up its own COM activator under
             HKLM\SOFTWARE\Classes\PackagedCom\Package\{PFN}\Class, matching the ExeServer whose
             Arguments are exactly the activation switch spelled out below (four hyphens, then
             AppNotificationActivated and a colon — the SDK compares it verbatim, so do not reword
             it). Without these two extensions that key does not exist, Register() throws, and EVERY
             notification the app would ever show is
             discarded — including the trigger's "nothing to convert" feedback, which in a packaged
             build was the only response a reviewer with one keyboard layout could have seen. The
             unpackaged (MSI) build registers its activator at runtime and is unaffected, which is
             why this only ever failed in the Store flavour.

             The CLSID is arbitrary but must stay stable and identical in both places. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="A1429C4E-F890-4788-A651-A737F40EF475" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Switcher3way.exe" DisplayName="Switcher3way"
                           Arguments="----AppNotificationActivated:">
              <com:Class Id="A1429C4E-F890-4788-A651-A737F40EF475" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Global keyboard hook + input injection require full trust; see the note above. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
