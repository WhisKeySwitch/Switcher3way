<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <!-- Framework-dependent for dev/CI builds here. The release packaging (self-contained vs the
         MSI installing the Windows App SDK runtime) is finalized in the build/MSI phase — it does
         not affect app code. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Switcher3way.App</RootNamespace>
    <AssemblyName>Switcher3way</AssemblyName>
    <Version>0.2.8</Version>
    <ApplicationIcon>Switcher3way.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Custom entry point (mutex + selftest) instead of the generated WinUI Main. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Two shipping flavours from one project:
         default            → unpackaged, installed by the WiX MSI (direct download)
         -p:Packaged=true   → MSIX for the Microsoft Store (Store signs it; no cert needed)
       PackageInfo.IsPackaged detects which one is running, so the updater and "start with
       Windows" behave correctly in each. -->
  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <!-- Lets the code compile out what a Store build must not contain — process launching, the MSI
         self-updater — rather than only skipping it at runtime. The App Certification Kit reads the
         binary, so unreachable code still fails its "Blocked executables" test. -->
    <DefineConstants>$(DefineConstants);PACKAGED</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Packaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Images\**\*.png" />
  </ItemGroup>

  <!-- One updater implementation per flavour: the MSI self-updater for direct downloads, a throwing
       stub for the Store. See UpdateInstaller.Store.cs for why this is file-level rather than #if. -->
  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <Compile Remove="UpdateInstaller.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Packaged)' != 'true'">
    <Compile Remove="UpdateInstaller.Store.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Switcher3way.Core\Switcher3way.Core.csproj" />
    <ProjectReference Include="..\Switcher3way.Dictionaries\Switcher3way.Dictionaries.csproj" />
  </ItemGroup>

  <!-- `dotnet publish` does NOT carry the compiled XAML (the .xbf files and resources.pri) into the
       publish folder for an unpackaged WinUI app, even though both sit in $(OutDir). The app then
       starts, shows its Win32 tray icon, and throws XamlParseException the moment any window is
       created — so an installed build looks half-dead: native fallback menu, Settings does nothing,
       no onboarding. Copy them explicitly, and fail the build if they are missing. -->
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <_XamlResource Include="$(OutDir)*.xbf" />
      <!-- The PRI is not emitted on every publish path; take it when it exists (it carries resource
           strings and scale-qualified assets, which our XAML does not currently rely on). -->
      <_XamlResource Include="$(OutDir)resources.pri" Condition="Exists('$(OutDir)resources.pri')" />
    </ItemGroup>
    <Error Condition="'@(_XamlResource)' == ''" Text="No compiled XAML (.xbf) found in $(OutDir) — the published app would fail to open any window." />
    <Copy SourceFiles="@(_XamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Published @(_XamlResource-&gt;Count()) XAML resource file(s)." />
  </Target>

  <!-- MIT requires the notice to accompany copies of the software, so it ships next to the exe in
       both flavours (the installer's EULA page only covers the moment of installation, and the Store
       package has no EULA page at all). -->
  <ItemGroup>
    <Content Include="..\..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tray flag images (public-domain flags), embedded and drawn as the layout indicator. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\en.png"><LogicalName>en.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\ru.png"><LogicalName>ru.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\uk.png"><LogicalName>uk.png</LogicalName></EmbeddedResource>
  </ItemGroup>

  <!-- User guide (single source of truth), embedded and rendered offline in the in-app Help window.
       WithCulture=false stops MSBuild reading ".uk"/".ru" as culture codes (→ satellite assemblies). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\docs\user-guide.md" WithCulture="false"><LogicalName>user-guide.md</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\..\docs\user-guide.uk.md" WithCulture="false"><LogicalName>user-guide.uk.md</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\..\docs\user-guide.ru.md" WithCulture="false"><LogicalName>user-guide.ru.md</LogicalName></EmbeddedResource>
  </ItemGroup>

</Project>
