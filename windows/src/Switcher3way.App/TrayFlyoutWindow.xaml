<Window
    x:Class="Switcher3way.App.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Switcher3way">

    <Grid x:Name="Root" Padding="4" RowSpacing="2"
          Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
        <Grid.Resources>
            <!-- Flat, full-width menu row: hover/press/focus from the standard button states. -->
            <Style x:Key="Row" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>
        </Grid.Resources>

        <StackPanel Spacing="2">
            <!-- Status header: flag + current layout + what's on -->
            <Grid Padding="10,8" ColumnSpacing="10" ColumnDefinitions="Auto,*">
                <Image x:Name="Flag" Width="24" Height="17" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LayoutName" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusSub" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <Border Height="1" Margin="6,0,6,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Quick toggles -->
            <Grid Padding="10,0" MinHeight="36" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="T_Enable" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="EnableSwitch" Grid.Column="1" OnContent="" OffContent=""
                              MinWidth="0" Toggled="EnableSwitch_Toggled" />
            </Grid>
            <Grid Padding="10,0" MinHeight="36" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="T_AutoFix" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="AutoFixSwitch" Grid.Column="1" OnContent="" OffContent=""
                              MinWidth="0" Toggled="AutoFixSwitch_Toggled" />
            </Grid>
            <Grid Padding="10,0" MinHeight="36" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="T_PerApp" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="PerAppSwitch" Grid.Column="1" OnContent="" OffContent=""
                              MinWidth="0" Toggled="PerAppSwitch_Toggled" />
            </Grid>

            <!-- Pause -->
            <TextBlock x:Name="T_Pause" Margin="10,6,10,2" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid x:Name="PauseButtons" Padding="10,0,10,4" ColumnSpacing="4"
                  ColumnDefinitions="*,*,*">
                <Button x:Name="Pause30" Content="30 min" FontSize="12" HorizontalAlignment="Stretch" Click="Pause30_Click" />
                <Button x:Name="Pause60" Grid.Column="1" Content="1 h" FontSize="12" HorizontalAlignment="Stretch" Click="Pause60_Click" />
                <Button x:Name="PauseRestart" Grid.Column="2" Content="Until restart" FontSize="12"
                        HorizontalAlignment="Stretch" Click="PauseRestart_Click" />
            </Grid>
            <Button x:Name="ResumeButton" Style="{StaticResource Row}" Click="Resume_Click" Visibility="Collapsed">
                <TextBlock x:Name="T_Resume" VerticalAlignment="Center" />
            </Button>

            <Border Height="1" Margin="6,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Commands -->
            <Button Style="{StaticResource Row}" Click="Settings_Click">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="T_Settings" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Ctrl+," FontFamily="Consolas" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Button>
            <Button x:Name="HelpButton" Style="{StaticResource Row}" Click="Help_Click">
                <TextBlock x:Name="T_Help" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="UpdatesButton" Style="{StaticResource Row}" Click="Updates_Click">
                <TextBlock x:Name="T_Updates" VerticalAlignment="Center" />
            </Button>

            <Border Height="1" Margin="6,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Button Style="{StaticResource Row}" Click="Quit_Click">
                <TextBlock x:Name="T_Quit" VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
