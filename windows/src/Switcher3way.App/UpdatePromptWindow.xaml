<Window
    x:Class="Switcher3way.App.UpdatePromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Switcher3way">

    <Grid Padding="22,20" RowSpacing="10"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Release notes, rendered (never raw markup) -->
        <Border x:Name="NotesCard" Grid.Row="2" Padding="16,14" CornerRadius="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer MaxHeight="220">
                <StackPanel Spacing="9">
                    <TextBlock x:Name="NotesHeader" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="NotesList" Spacing="7" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button x:Name="InstallButton" Style="{StaticResource AccentButtonStyle}" Click="Install_Click" />
            <Button x:Name="LaterButton" Grid.Column="1" Click="Later_Click" />
            <HyperlinkButton x:Name="SkipButton" Grid.Column="3" Click="Skip_Click" />
        </Grid>
    </Grid>
</Window>
