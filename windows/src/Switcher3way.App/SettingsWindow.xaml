<Window
    x:Class="Switcher3way.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Switcher3way — Settings">

    <Grid RowDefinitions="Auto,*,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <!-- Hand-built SettingsCard: title + description on the left, control on the right. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!-- One exceptions row: icon + name + .exe, then Locked or a remove button. -->
            <DataTemplate x:Key="RowTemplate">
                <Grid ColumnSpacing="10" Padding="12,0" Height="40"
                      ColumnDefinitions="Auto,Auto,*,Auto">
                    <Image Width="20" Height="20" Source="{Binding Icon}"
                           Visibility="{Binding IconVisibility}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Sub}" FontSize="12" VerticalAlignment="Center"
                               Visibility="{Binding SubVisibility}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Column="3" Text="Locked" FontSize="12" VerticalAlignment="Center"
                               Visibility="{Binding LockedVisibility}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Button Grid.Column="3" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                            Padding="8,4" Tag="{Binding Value}" Click="RemoveRow_Click"
                            Visibility="{Binding RemoveVisibility}" />
                </Grid>
            </DataTemplate>

            <!-- One row in the Add-an-app picker. -->
            <DataTemplate x:Key="PickerTemplate">
                <Grid ColumnSpacing="10" Height="36" ColumnDefinitions="Auto,*,Auto">
                    <Image Width="20" Height="20" VerticalAlignment="Center"
                           Source="{Binding Icon}" Visibility="{Binding IconVisibility}" />
                    <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Sub}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>


        <SelectorBar x:Name="Tabs" Grid.Row="0" Margin="20,12,20,0" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Name="TabGeneral" Text="General" IsSelected="True" />
            <SelectorBarItem x:Name="TabAutoFix" Text="Auto-fix" />
            <SelectorBarItem x:Name="TabAdvanced" Text="Advanced" />
            <SelectorBarItem x:Name="TabAbout" Text="About" />
        </SelectorBar>

        <ScrollViewer Grid.Row="1" Padding="20,16,20,20">
            <Grid>
                <StackPanel x:Name="GeneralPanel" Spacing="14">
                    <!-- Status card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="StatusLine" Text="—" />
                                <TextBlock x:Name="StatusSub" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border x:Name="StatusPill" Grid.Column="1" CornerRadius="999" Padding="10,3"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                <TextBlock x:Name="StatusPillText" Text="Active" FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="3">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Enable Switcher3way" />
                                    <TextBlock Text="Watch what you type and fix the layout when a word is clearly in the wrong one"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EnableToggle" Grid.Column="1" Toggled="EnableToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Remember layout per application" />
                                    <TextBlock Text="Restore each app's last layout when you switch back to it"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PerAppToggle" Grid.Column="1" Toggled="PerAppToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Text="Switcher3way runs in the notification area"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="StartupToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Trigger" FontWeight="SemiBold" Margin="2,4,0,0" />
                    <StackPanel Spacing="3">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Trigger key" />
                                    <TextBlock Text="Converts the last word or the selection. Tap again to undo."
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="TriggerCombo" Grid.Column="1" MinWidth="170"
                                          SelectionChanged="TriggerCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Interface language" />
                                    <TextBlock Text="16 languages available" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="200"
                                          SelectionChanged="LanguageCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Auto-fix -->
                <StackPanel x:Name="AutoFixPanel" Visibility="Collapsed" Spacing="14">
                    <StackPanel Spacing="3">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Fix layout automatically as I type" />
                                    <TextBlock Text="Only for finished words that pass their language's dictionary"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoFixToggle" Grid.Column="1" Toggled="AutoFixToggle_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Spacing="2" MaxWidth="330">
                                    <TextBlock Text="Language for ambiguous words" />
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Used when a word is valid in both Ukrainian and Russian. If the phrase later proves to be the other language, it is corrected automatically." />
                                </StackPanel>
                                <ComboBox x:Name="AmbiguousCombo" Grid.Column="1" MinWidth="150"
                                          SelectionChanged="AmbiguousCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Exceptions" FontWeight="SemiBold" />
                            <TextBlock Text="Where auto-fix stays off, and words to never or always convert"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="6">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <!-- Toolbar: segments + search -->
                                <Grid Grid.Row="0" Padding="12,10" ColumnDefinitions="*,Auto"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <SelectorBar x:Name="ExcSeg" SelectionChanged="ExcSeg_SelectionChanged">
                                        <SelectorBarItem x:Name="SegApps" Text="Apps" IsSelected="True" />
                                        <SelectorBarItem x:Name="SegNever" Text="Never convert" />
                                        <SelectorBarItem x:Name="SegAlways" Text="Always convert" />
                                    </SelectorBar>
                                    <TextBox x:Name="ExcSearch" Grid.Column="1" Width="150" PlaceholderText="Search"
                                             TextChanged="ExcSearch_TextChanged" />
                                </Grid>

                                <!-- List -->
                                <ScrollViewer Grid.Row="1" MaxHeight="240">
                                    <StackPanel>
                                        <!-- TextBlock has no Background in WinUI — headers are wrapped. -->
                                        <Border x:Name="ProtectedHeader" Padding="12,8"
                                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                                            <TextBlock FontSize="12" Text="Always off — password managers, not removable"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <ItemsControl x:Name="ProtectedList" ItemTemplate="{StaticResource RowTemplate}" />
                                        <Border x:Name="UserHeader" Padding="12,8"
                                                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                                            <TextBlock FontSize="12" Text="Added by you"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <ItemsControl x:Name="UserList" ItemTemplate="{StaticResource RowTemplate}" />
                                        <TextBlock x:Name="EmptyNote" Padding="12,10" FontSize="13"
                                                   Visibility="Collapsed" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Footer: add app, or add word -->
                                <Grid Grid.Row="2" Padding="12,10" ColumnSpacing="8" ColumnDefinitions="Auto,*"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <Button x:Name="AddAppButton" Content="+ Add app…" Style="{StaticResource AccentButtonStyle}"
                                            Click="AddApp_Click" />
                                    <TextBlock x:Name="AddAppHint" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                               Text="Pick from running apps"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBox x:Name="AddWordBox" Grid.Column="0" Width="280" Visibility="Collapsed"
                                             PlaceholderText="Add a word, then click Add" KeyDown="AddWordBox_KeyDown" />
                                    <Button x:Name="AddWordButton" Grid.Column="1" Content="Add" Visibility="Collapsed"
                                            HorizontalAlignment="Left" Click="AddWord_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- Advanced -->
                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Spacing="3">
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Check for updates automatically" />
                                <TextBlock Text="Looks for new Windows builds once a day"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="UpdatesToggle" Grid.Column="1" Toggled="UpdatesToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Debug logging" />
                                <TextBlock Text="Records what was detected and converted, for troubleshooting"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DebugToggle" Grid.Column="1" Toggled="DebugToggle_Toggled" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Log file" />
                                <TextBlock x:Name="LogPathText" FontSize="12" IsTextSelectionEnabled="True"
                                           FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open log folder" Click="OpenLog_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Spacing="10" Padding="4,8">
                    <Image x:Name="AboutIcon" Width="64" Height="64" HorizontalAlignment="Left" />
                    <TextBlock Text="Switcher3way" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Auto-fix your keyboard layout across English, Ukrainian, and Russian."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AboutVersion" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="MIT License · a fork of RuSwitcher, generalized to N-way."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,0">
                        <HyperlinkButton Content="Website" NavigateUri="https://whiskeyswitch.github.io/Switcher3way/" />
                        <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/WhisKeySwitch/Switcher3way" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="20,12" ColumnDefinitions="*,Auto"
              Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="Changes apply as you make them" VerticalAlignment="Center"
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Close" Click="Close_Click" MinWidth="90" />
        </Grid>
    </Grid>
</Window>
