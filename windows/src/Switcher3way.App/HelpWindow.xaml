<Window
    x:Class="Switcher3way.App.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Switcher3way — Help">

    <Grid ColumnDefinitions="172,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- Section rail + language pills -->
        <Grid Padding="8,10" RowDefinitions="*,Auto">
            <ItemsControl x:Name="SectionList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}" Tag="{Binding Anchor}" Click="Section_Click"
                                Background="Transparent" BorderThickness="0" CornerRadius="5"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="12,7" FontSize="13" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Padding="8,8">
                <Button x:Name="LangEn" Content="EN" Tag="en" Click="Lang_Click" FontSize="11"
                        CornerRadius="999" Padding="9,3" />
                <Button x:Name="LangUk" Content="УК" Tag="uk" Click="Lang_Click" FontSize="11"
                        CornerRadius="999" Padding="9,3" />
                <Button x:Name="LangRu" Content="РУ" Tag="ru" Click="Lang_Click" FontSize="11"
                        CornerRadius="999" Padding="9,3" />
            </StackPanel>
        </Grid>

        <!-- Rendered guide -->
        <Border Grid.Column="1" BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <controls:WebView2 x:Name="View" NavigationStarting="View_NavigationStarting" />
                <TextBlock x:Name="FallbackText" Visibility="Collapsed" Padding="24" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
